{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.8-flash",
  "providers": {
    "google": {
      "package": "@ai-sdk/google",
      "settings": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-3.8-flash": {
          "modelID": "gemini-3.8-flash",
          "name": "Gemini 3.8 Flash"
        }
      }
    }
  }
}